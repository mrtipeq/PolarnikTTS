[Desktop Entry]
Type=Application
Version=1.0
Name=Install PolarnikTTS
Comment=Installs the PolarnikTTS engine server and registers it in Chrome
Icon=audio-speakers
Terminal=true
Exec=bash -c 'cd "$(dirname "$1")" && bash ./install.sh; status=$?; echo; if [ $status -eq 0 ]; then echo "PolarnikTTS is installed. You can close this window and press Start server in the extension."; else echo "Something went wrong (exit code $status) - see the messages above."; fi; read -r -p "Press Enter to close this window..." _' _ %k
